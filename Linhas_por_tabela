-- LISTAGEM DE TABELAS USADAS NO RELATÓRIO,
-- EXIBE QUANTIDADE DE LINHAS POR MES DISTINTO


ALTER VIEW VW_CLIENTE_ESTAGIO_QTD_LINHA_TABELAS AS									-- IDENTIFICACAO DA VIEW

SELECT 
    COALESCE(A.MES, B.MES, C.MES, D.MES) AS MES,									-- COLUNA A SER USADA COMO CHAVE PRIMARIA 
    A.QTD AS TB_CLIENTE_ESTAGIO_NOME_BASEADO_NA_TABELA_ORIGINAL,	-- COLUNA QUE SERA USADA PARA CONTAR A QUANTIDADE DE LINHAS
    B.QTD AS TB_CLIENTE_ESTAGIO_NOME_BASEADO_NA_TABELA_ORIGINAL,	-- COLUNA QUE SERA USADA PARA CONTAR A QUANTIDADE DE LINHAS
    C.QTD AS TB_CLIENTE_ESTAGIO_NOME_BASEADO_NA_TABELA_ORIGINAL,	-- COLUNA QUE SERA USADA PARA CONTAR A QUANTIDADE DE LINHAS
    D.QTD AS TB_CLIENTE_ESTAGIO_NOME_BASEADO_NA_TABELA_ORIGINAL		-- COLUNA QUE SERA USADA PARA CONTAR A QUANTIDADE DE LINHAS
FROM 
    (SELECT MES, COUNT(indicador) AS QTD 
     FROM DB_CLIENTE.dbo.TB_CLIENTE_ESTAGIO_NOME_BASEADO_NA_TABELA_ORIGINAL		-- ENDERECO DA TABELA
     GROUP BY MES) A																                        -- COLUNA QUE SERA USADA NO JOIN
FULL OUTER JOIN 
    (SELECT MES, COUNT(indicador) AS QTD 
     FROM DB_CLIENTE.dbo.TB_CLIENTE_ESTAGIO_NOME_BASEADO_NA_TABELA_ORIGINAL		-- ENDERECO DA TABELA
     GROUP BY MES) B ON A.MES = B.MES												                -- COLUNA QUE SERA USADA NO JOIN (SEMPRE INSERIR AS COLUNAS CONFORME AS TABELAS0
FULL OUTER JOIN 
    (SELECT MES, COUNT(indicador) AS QTD 
     FROM DB_CLIENTE.dbo.TB_CLIENTE_ESTAGIO_NOME_BASEADO_NA_TABELA_ORIGINAL		-- ENDERECO DA TABELA
     GROUP BY MES) C ON COALESCE(A.MES, B.MES) = C.MES								      -- COLUNA QUE SERA USADA NO JOIN (SEMPRE INSERIR AS COLUNAS CONFORME AS TABELAS0
FULL OUTER JOIN 
    (SELECT MES, COUNT(indicador) AS QTD 
     FROM DB_CLIENTE.dbo.TB_CLIENTE_ESTAGIO_NOME_BASEADO_NA_TABELA_ORIGINAL		-- ENDERECO DA TABELA
     GROUP BY MES) D ON COALESCE(A.MES, B.MES, C.MES) = D.MES;						  -- COLUNA QUE SERA USADA NO JOIN (SEMPRE INSERIR AS COLUNAS CONFORME AS TABELAS0
