CREATE PROCEDURE [dbo].[PRC_TB_INF_TABLE] 
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @SQL NVARCHAR(MAX) = N'';
    DECLARE @DatabaseName NVARCHAR(128);

    -- Iterate over all databases excluding system databases
    DECLARE db_cursor CURSOR FOR
    SELECT name
    FROM sys.databases
    WHERE name -- NOT IN ('master', 'model', 'msdb', 'tempdb');
	IN ('INTEGRACAO','PLANEJAMENTO','DB_DE_PARA')

    OPEN db_cursor;

    FETCH NEXT FROM db_cursor INTO @DatabaseName;

    -- Loop through each database and construct dynamic SQL
    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @SQL = @SQL + '
        IF ''[' + @DatabaseName + ']'' NOT IN (''master'', ''model'', ''msdb'', ''tempdb'')
        BEGIN
            INSERT INTO dbo.TB_INF_TABLE (
                NM_DATABASE_NOME, NM_TABLE_CATALOG, NM_TABLE_TYPE, NM_TABLE_NAME,
                NM_COLUMN_NAME, NM_DATA_TYPE, NR_QTD_MAX_CARACTER, DT_DATA_CAPTURADO
            )
            SELECT 
                ''' + @DatabaseName + ''' AS NM_DATABASE_NOME,
                t.TABLE_CATALOG AS NM_TABLE_CATALOG,
                t.TABLE_TYPE AS NM_TABLE_TYPE,
                t.TABLE_NAME AS NM_TABLE_NAME,
                c.COLUMN_NAME AS NM_COLUMN_NAME,
                c.DATA_TYPE AS NM_DATA_TYPE,
                c.CHARACTER_MAXIMUM_LENGTH AS NR_QTD_MAX_CARACTER,
                GETDATE() AS DT_DATA_CAPTURADO
            FROM [' + @DatabaseName + '].INFORMATION_SCHEMA.TABLES t
            JOIN [' + @DatabaseName + '].INFORMATION_SCHEMA.COLUMNS c 
                ON t.TABLE_NAME = c.TABLE_NAME
                AND t.TABLE_SCHEMA = c.TABLE_SCHEMA
            WHERE c.CHARACTER_MAXIMUM_LENGTH IS NOT NULL;
        END;
        ';

        FETCH NEXT FROM db_cursor INTO @DatabaseName;
    END;

    CLOSE db_cursor;
    DEALLOCATE db_cursor;

    -- Execute the dynamic SQL
    EXEC sp_executesql @SQL;
END;
